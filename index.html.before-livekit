
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#10251e">
<title>The Sanctuary</title>

<style>
* { box-sizing: border-box; }

body {
  margin: 0;
    min-height: 100vh;
      font-family: system-ui, sans-serif;
        color: #f1f6ef;
          background: radial-gradient(ellipse at top, #28513c, #10251e 65%, #091610);
          }

          header {
            padding: 24px 18px 12px;
              text-align: center;
              }

              .brand {
                color: #c4e6b5;
                  letter-spacing: 3px;
                    font-size: 12px;
                    }

                    h1 { margin: 8px 0 4px; font-size: 27px; }
                    .subtitle { color: #b6c9bb; font-size: 13px; }

                    main {
                      max-width: 560px;
                        margin: auto;
                          padding: 14px 18px 28px;
                          }

                          .room {
                            border: 1px solid #456653;
                              border-radius: 24px;
                                padding: 22px 14px;
                                  background: #10271ed9;
                                    box-shadow: 0 15px 45px #0004;
                                    }

                                    .room-top {
                                      display: flex;
                                        justify-content: space-between;
                                          align-items: center;
                                            margin-bottom: 22px;
                                              gap: 8px;
                                              }

                                              .room-top strong { font-size: 15px; }

                                              .pill {
                                                border: 1px solid #52735c;
                                                  border-radius: 20px;
                                                    padding: 6px 10px;
                                                      font-size: 11px;
                                                        color: #c4e6b5;
                                                          white-space: nowrap;
                                                          }

                                                          .people {
                                                            display: grid;
                                                              grid-template-columns: repeat(3, minmax(0, 1fr));
                                                                gap: 24px 8px;
                                                                  padding: 8px 0 25px;
                                                                  }

                                                                  .person {
                                                                    text-align: center;
                                                                      min-width: 0;
                                                                      }

                                                                      .avatar {
                                                                        width: clamp(70px, 23vw, 100px);
                                                                          height: clamp(70px, 23vw, 100px);
                                                                            margin: auto auto 9px;
                                                                              border-radius: 50%;
                                                                                border: 2px solid #617d68;
                                                                                  background: linear-gradient(145deg, #668b69, #203e31 65%, #13281f);
                                                                                    display: flex;
                                                                                      align-items: center;
                                                                                        justify-content: center;
                                                                                          font-size: 34px;
                                                                                            position: relative;
                                                                                              overflow: hidden;
                                                                                                box-shadow: 0 0 0 4px #8db99b12;
                                                                                                  transition: box-shadow .2s;
                                                                                                  }

                                                                                                  .avatar video {
                                                                                                    position: absolute;
                                                                                                      inset: 0;
                                                                                                        width: 100%;
                                                                                                          height: 100%;
                                                                                                            object-fit: cover;
                                                                                                              border-radius: 50%;
                                                                                                                transform: scaleX(-1);
                                                                                                                  background: #10251e;
                                                                                                                  }

                                                                                                                  .avatar video[hidden],
                                                                                                                  .camera-placeholder[hidden] {
                                                                                                                    display: none;
                                                                                                                    }

                                                                                                                    .camera-placeholder {
                                                                                                                      position: relative;
                                                                                                                        z-index: 1;
                                                                                                                          pointer-events: none;
                                                                                                                          }

                                                                                                                          .person.speaking .avatar {
                                                                                                                            border-color: #a8ffad;
                                                                                                                              animation: speakerGlow 1.2s ease-in-out infinite alternate;
                                                                                                                              }

                                                                                                                              .person.speaking .avatar::after {
                                                                                                                                content: "♫";
                                                                                                                                  position: absolute;
                                                                                                                                    right: 0;
                                                                                                                                      bottom: 0;
                                                                                                                                        width: 25px;
                                                                                                                                          height: 25px;
                                                                                                                                            border-radius: 50%;
                                                                                                                                              background: #64d989;
                                                                                                                                                color: #10251e;
                                                                                                                                                  font-size: 17px;
                                                                                                                                                    display: grid;
                                                                                                                                                      place-items: center;
                                                                                                                                                        z-index: 2;
                                                                                                                                                        }

                                                                                                                                                        @keyframes speakerGlow {
                                                                                                                                                          from { box-shadow: 0 0 5px 2px #65ff9144; }
                                                                                                                                                            to { box-shadow: 0 0 14px 5px #65ff91aa, 0 0 28px #4bff805c; }
                                                                                                                                                            }

                                                                                                                                                            .name { font-size: 12px; }
                                                                                                                                                            .status { color: #9eb9a4; font-size: 10px; margin-top: 3px; }

                                                                                                                                                            .timer {
                                                                                                                                                              text-align: center;
                                                                                                                                                                padding: 18px 10px;
                                                                                                                                                                  border-radius: 18px;
                                                                                                                                                                    background: linear-gradient(120deg, #244b36, #183526);
                                                                                                                                                                      border: 1px solid #486a50;
                                                                                                                                                                      }

                                                                                                                                                                      .timer-label { font-size: 12px; color: #c3d9c7; }

                                                                                                                                                                      #clock {
                                                                                                                                                                        font-size: 38px;
                                                                                                                                                                          font-weight: 300;
                                                                                                                                                                            margin: 5px 0;
                                                                                                                                                                            }

                                                                                                                                                                            #timerState { font-size: 11px; color: #b7d9b6; }

                                                                                                                                                                            .controls {
                                                                                                                                                                              display: grid;
                                                                                                                                                                                grid-template-columns: repeat(4, minmax(0, 1fr));
                                                                                                                                                                                  gap: 8px;
                                                                                                                                                                                    margin-top: 20px;
                                                                                                                                                                                    }

                                                                                                                                                                                    .control {
                                                                                                                                                                                      border: 1px solid #496653;
                                                                                                                                                                                        background: #213d2d;
                                                                                                                                                                                          color: white;
                                                                                                                                                                                            border-radius: 15px;
                                                                                                                                                                                              padding: 13px 3px;
                                                                                                                                                                                                font-size: 11px;
                                                                                                                                                                                                  cursor: pointer;
                                                                                                                                                                                                  }

                                                                                                                                                                                                  .control .symbol {
                                                                                                                                                                                                    display: block;
                                                                                                                                                                                                      font-size: 21px;
                                                                                                                                                                                                        margin-bottom: 5px;
                                                                                                                                                                                                        }

                                                                                                                                                                                                        .control.active {
                                                                                                                                                                                                          background: #386c49;
                                                                                                                                                                                                            border-color: #8edba0;
                                                                                                                                                                                                            }

                                                                                                                                                                                                            .control.leave {
                                                                                                                                                                                                              background: #663d3b;
                                                                                                                                                                                                                border-color: #98605a;
                                                                                                                                                                                                                }

                                                                                                                                                                                                                .control:disabled { opacity: .55; cursor: not-allowed; }

                                                                                                                                                                                                                .note {
                                                                                                                                                                                                                  color: #9db4a2;
                                                                                                                                                                                                                    font-size: 11px;
                                                                                                                                                                                                                      text-align: center;
                                                                                                                                                                                                                        line-height: 1.6;
                                                                                                                                                                                                                          margin: 18px 4px 0;
                                                                                                                                                                                                                          }

                                                                                                                                                                                                                          h2 { font-size: 16px; margin: 24px 0 10px; }

                                                                                                                                                                                                                          .feature {
                                                                                                                                                                                                                            padding: 13px;
                                                                                                                                                                                                                              border: 1px solid #34513e;
                                                                                                                                                                                                                                background: #142a20;
                                                                                                                                                                                                                                  border-radius: 13px;
                                                                                                                                                                                                                                    margin-top: 8px;
                                                                                                                                                                                                                                      font-size: 13px;
                                                                                                                                                                                                                                      }

                                                                                                                                                                                                                                      .feature span { color: #abcbb0; font-size: 12px; }

                                                                                                                                                                                                                                      footer {
                                                                                                                                                                                                                                        text-align: center;
                                                                                                                                                                                                                                          color: #78917e;
                                                                                                                                                                                                                                            font-size: 11px;
                                                                                                                                                                                                                                              padding: 15px;
                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                              @media (max-width: 360px) {
                                                                                                                                                                                                                                                main { padding-left: 10px; padding-right: 10px; }
                                                                                                                                                                                                                                                  .room { padding-left: 10px; padding-right: 10px; }
                                                                                                                                                                                                                                                    .controls { gap: 5px; }
                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                    </style>
                                                                                                                                                                                                                                                    </head>

                                                                                                                                                                                                                                                    <body>
                                                                                                                                                                                                                                                    <header>
                                                                                                                                                                                                                                                      <div class="brand">✳ THE SANCTUARY</div>
                                                                                                                                                                                                                                                        <h1>Meditate together</h1>
                                                                                                                                                                                                                                                          <div class="subtitle">A little peace, shared with others.</div>
                                                                                                                                                                                                                                                          </header>

                                                                                                                                                                                                                                                          <main>
                                                                                                                                                                                                                                                          <section class="room">

                                                                                                                                                                                                                                                            <div class="room-top">
                                                                                                                                                                                                                                                                <strong>🌲 Forest Room</strong>
                                                                                                                                                                                                                                                                    <span class="pill" id="count">3 / 8 people</span>
                                                                                                                                                                                                                                                                      </div>

                                                                                                                                                                                                                                                                        <div class="people">

                                                                                                                                                                                                                                                                            <div class="person" id="localPerson">
                                                                                                                                                                                                                                                                                  <div class="avatar">
                                                                                                                                                                                                                                                                                          <video id="localVideo" autoplay playsinline muted hidden></video>
                                                                                                                                                                                                                                                                                                  <span class="camera-placeholder" id="cameraPlaceholder">🧘🏻</span>
                                                                                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                                                                                              <div class="name">You</div>
                                                                                                                                                                                                                                                                                                                    <div class="status" id="localStatus">Camera off</div>
                                                                                                                                                                                                                                                                                                                        </div>

                                                                                                                                                                                                                                                                                                                            <div class="person">
                                                                                                                                                                                                                                                                                                                                  <div class="avatar">
                                                                                                                                                                                                                                                                                                                                          <span class="camera-placeholder">🧘🏽‍♀️</span>
                                                                                                                                                                                                                                                                                                                                                </div>
                                                                                                                                                                                                                                                                                                                                                      <div class="name">Maya</div>
                                                                                                                                                                                                                                                                                                                                                            <div class="status">Demo participant</div>
                                                                                                                                                                                                                                                                                                                                                                </div>

                                                                                                                                                                                                                                                                                                                                                                    <div class="person">
                                                                                                                                                                                                                                                                                                                                                                          <div class="avatar">
                                                                                                                                                                                                                                                                                                                                                                                  <span class="camera-placeholder">🧘🏻‍♂️</span>
                                                                                                                                                                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                                                                                                                                                                              <div class="name">Jun</div>
                                                                                                                                                                                                                                                                                                                                                                                                    <div class="status">Demo participant</div>
                                                                                                                                                                                                                                                                                                                                                                                                        </div>

                                                                                                                                                                                                                                                                                                                                                                                                          </div>

                                                                                                                                                                                                                                                                                                                                                                                                            <div class="timer">
                                                                                                                                                                                                                                                                                                                                                                                                                <div class="timer-label">MEDITATION TIMER · THIS DEVICE</div>
                                                                                                                                                                                                                                                                                                                                                                                                                    <div id="clock">20:00</div>
                                                                                                                                                                                                                                                                                                                                                                                                                        <div id="timerState">Ready when you are</div>
                                                                                                                                                                                                                                                                                                                                                                                                                          </div>

                                                                                                                                                                                                                                                                                                                                                                                                                            <div class="controls">
                                                                                                                                                                                                                                                                                                                                                                                                                                <button class="control" id="mic" type="button">
                                                                                                                                                                                                                                                                                                                                                                                                                                      <span class="symbol">🎙</span>Mic on
                                                                                                                                                                                                                                                                                                                                                                                                                                          </button>

                                                                                                                                                                                                                                                                                                                                                                                                                                              <button class="control" id="camera" type="button">
                                                                                                                                                                                                                                                                                                                                                                                                                                                    <span class="symbol">◉</span>Camera on
                                                                                                                                                                                                                                                                                                                                                                                                                                                        </button>

                                                                                                                                                                                                                                                                                                                                                                                                                                                            <button class="control" id="start" type="button">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <span class="symbol">▶</span>Start
                                                                                                                                                                                                                                                                                                                                                                                                                                                                      </button>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <button class="control leave" id="leave" type="button">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <span class="symbol">↗</span>Leave
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </button>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <p class="note" id="message">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            Tap Camera on to request camera and microphone access.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                Your video stays on this device; no call is connected.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  </p>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  </section>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <h2>Your room, your rhythm</h2>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <div class="feature">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    🌿 <strong>Speak freely</strong><br>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <span>Test your microphone locally. Other people are not connected yet.</span>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <div class="feature">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ✨ <strong>Gentle speaker glow</strong><br>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <span>The glow reacts to microphone volume while your mic is on.</span>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <div class="feature">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            ⏱️ <strong>A quiet moment</strong><br>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <span>This prototype timer runs on this device only.</span>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              </div>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <footer>THE SANCTUARY · A SPACE TO BE TOGETHER</footer>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              </main>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              <script>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              let seconds = 1200;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              let running = false;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              let muted = false;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              let cameraOff = true;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              let interval = null;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              let localStream = null;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              let audioContext = null;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              let analyser = null;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              let speakingFrame = null;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              let mediaBusy = false;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              let leftRoom = false;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              const video = document.getElementById("localVideo");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              const micButton = document.getElementById("mic");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              const cameraButton = document.getElementById("camera");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              const startButton = document.getElementById("start");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              const leaveButton = document.getElementById("leave");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              const message = document.getElementById("message");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              const localPerson = document.getElementById("localPerson");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              const localStatus = document.getElementById("localStatus");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              const placeholder = document.getElementById("cameraPlaceholder");

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              function showTime() {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                const m = Math.floor(seconds / 60);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  const s = seconds % 60;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    document.getElementById("clock").textContent =
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        String(m).padStart(2, "0") + ":" +
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            String(s).padStart(2, "0");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            function toggleTimer() {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              if (leftRoom) return;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if (running) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    running = false;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        clearInterval(interval);

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            startButton.innerHTML =
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  '<span class="symbol">▶</span>Resume';

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      document.getElementById("timerState").textContent =
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            "Paused — take your time";
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                return;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if (seconds <= 0) seconds = 1200;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      running = true;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        startButton.innerHTML =
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            '<span class="symbol">Ⅱ</span>Pause';

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              startButton.classList.add("active");

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                document.getElementById("timerState").textContent =
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    "Meditation in progress";

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      interval = setInterval(() => {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          if (seconds > 0) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                seconds--;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      showTime();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          } else {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                running = false;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      clearInterval(interval);

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            startButton.innerHTML =
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    '<span class="symbol">↻</span>Restart';

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          startButton.classList.remove("active");

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                document.getElementById("timerState").textContent =
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        "Session complete. Well done.";
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              }, 1000);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              async function startMedia() {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if (leftRoom || mediaBusy) return false;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  if (!navigator.mediaDevices ||
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        !navigator.mediaDevices.getUserMedia) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            message.textContent =
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  "Camera access is unavailable. Open the HTTPS preview in a supported browser.";
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      return false;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          mediaBusy = true;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            message.textContent =
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                "Requesting camera and microphone permission…";

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  try {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      const stream = await navigator.mediaDevices.getUserMedia({
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            video: {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    facingMode: "user",
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            width: { ideal: 480 },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    height: { ideal: 480 }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          },
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                audio: {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        echoCancellation: true,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                noiseSuppression: true
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          });

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              localStream = stream;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  video.srcObject = stream;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      video.hidden = false;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          placeholder.hidden = true;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              cameraOff = false;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  muted = false;

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      await video.play();

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          cameraButton.innerHTML =
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                '<span class="symbol">◉</span>Camera on';
